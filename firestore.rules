rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }
    function configuredVendor(uid) {
      let profile = get(/databases/$(database)/documents/users/$(uid)).data;
      return owns(uid) && profile.role == 'vendor'
        && profile.stallSetupComplete == true && profile.stallId == uid;
    }
    function validStallPicture(id) {
      return id is string && id in [
        'bento', 'bibimbap', 'burger', 'cake',
        'chinese_food_1', 'chinese_food_2', 'chinese_food_3', 'chinese_food_4',
        'coffee', 'dessert', 'drink', 'fruit_juice', 'icecream', 'japanese_1',
        'japanese_curry', 'korean_ramen', 'malay_drinks', 'malay_food',
        'nasi_lemak', 'sushi', 'teh_ais', 'tteokbokki', 'western_food'
      ];
    }
    function validStallUpdate(data, uid) {
      return data.keys().hasAll(['ownerUid', 'name', 'category', 'preparationMinutes', 'status', 'createdAt', 'updatedAt'])
        && data.ownerUid == uid && data.ownerUid == resource.data.ownerUid
        && data.createdAt == resource.data.createdAt
        && data.updatedAt is timestamp && data.updatedAt == request.time
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.name.matches('.*\\S.*')
        && data.category is string && data.category in ['Malay', 'Western', 'Chinese', 'Japanese', 'Korean', 'Beverage', 'Dessert']
        && data.preparationMinutes is int && data.preparationMinutes >= 1 && data.preparationMinutes <= 180
        && data.status in ['open', 'closed']
        && (!('pictureId' in data) || validStallPicture(data.pictureId))
        // Other existing fields are preserved; new unapproved fields, removals
        // or changes to ownership, creation time and queue/order data are denied.
        && data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'category', 'preparationMinutes', 'status', 'pictureId', 'updatedAt']);
    }
    // Safety gate: do not enable destructive menu writes before emulator proof
    // and review. Category deletion remains denied even when this gate changes.
    function menuDeletesEnabled() { return false; }
    function categoryPath(uid, id) {
      return /databases/$(database)/documents/stalls/$(uid)/menuCategories/$(id);
    }
    function foodPath(uid, id) {
      return /databases/$(database)/documents/stalls/$(uid)/menuFoods/$(id);
    }
    function membershipPath(uid, id) {
      return /databases/$(database)/documents/stalls/$(uid)/menuMemberships/$(id);
    }
    function categoryNamePath(uid, key) {
      return /databases/$(database)/documents/stalls/$(uid)/menuCategoryNames/$(key);
    }
    function validMenuCategory(d, uid) {
      return d.keys().hasAll(['vendorUid','name','nameKey','revision','createdAt','updatedAt'])
        && d.keys().hasOnly(['vendorUid','name','nameKey','revision','createdAt','updatedAt'])
        && d.vendorUid == uid && d.name is string && d.name.size() >= 1 && d.name.size() <= 50
        && d.name.matches('^[^\\s/]+( [^\\s/]+)*$')
        && d.nameKey == d.name.lower() && !(d.nameKey in ['.','..'])
        && !d.nameKey.matches('__.*__')
        && d.revision is int && d.revision >= 1 && d.createdAt is timestamp
        && d.updatedAt == request.time;
    }
    function validMenuFood(d, uid) {
      return d.keys().hasAll(['vendorUid','name','description','priceSen','categoryId','pictureId','available','revision','createdAt','updatedAt'])
        && d.keys().hasOnly(['vendorUid','name','description','priceSen','categoryId','pictureId','available','revision','createdAt','updatedAt'])
        && d.vendorUid == uid && d.name is string && d.name.size() >= 1 && d.name.size() <= 100
        && d.name.matches('^\\S([\\s\\S]*\\S)?$')
        && d.description is string && d.description.size() >= 1 && d.description.size() <= 500
        && d.description.matches('^\\S([\\s\\S]*\\S)?$')
        && d.priceSen is int && d.priceSen >= 1 && d.priceSen <= 100000
        && d.categoryId is string && d.categoryId.size() >= 1 && d.categoryId.size() <= 128
        && d.categoryId.matches('^[^/]+$')
        && validStallPicture(d.pictureId) && d.available is bool
        && d.revision is int && d.revision >= 1 && d.createdAt is timestamp
        && d.updatedAt == request.time;
    }
    function linkedFood(uid, id, categoryId) {
      return getAfter(categoryPath(uid, categoryId)).data.vendorUid == uid
        && getAfter(membershipPath(uid, id)).data.vendorUid == uid
        && getAfter(membershipPath(uid, id)).data.categoryId == categoryId;
    }
    function validProfile(data, uid) {
      return data.keys().hasAll(['uid', 'fullName', 'email', 'phoneNumber', 'role', 'createdAt', 'stallSetupComplete', 'stallId'])
        && data.keys().hasOnly(['uid', 'fullName', 'email', 'phoneNumber', 'role', 'createdAt', 'stallSetupComplete', 'stallId'])
        && data.uid == uid
        && data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 100
        && data.email is string && data.email == request.auth.token.email
        && data.phoneNumber is string && data.phoneNumber.size() >= 8 && data.phoneNumber.size() <= 30
        && data.role in ['student', 'vendor'] && data.createdAt is timestamp
        && data.stallSetupComplete is bool
        && ((!data.stallSetupComplete && data.stallId == null)
          || (data.role == 'vendor' && data.stallSetupComplete && data.stallId == uid));
    }
    function validStall(data, uid) {
      return data.keys().hasAll(['ownerUid', 'name', 'category', 'preparationMinutes', 'status', 'createdAt'])
        && data.keys().hasOnly(['ownerUid', 'name', 'category', 'preparationMinutes', 'status', 'createdAt'])
        && data.ownerUid == uid
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.category is string && data.category in ['Malay', 'Western', 'Chinese', 'Japanese', 'Korean', 'Beverage', 'Dessert']
        && data.preparationMinutes is int && data.preparationMinutes >= 1 && data.preparationMinutes <= 180
        && data.status == 'closed' && data.createdAt == request.time;
    }
    match /users/{uid} {
      allow get: if owns(uid);
      allow list, delete: if false;
      allow create: if owns(uid) && validProfile(request.resource.data, uid)
        && request.resource.data.createdAt == request.time
        && request.resource.data.stallSetupComplete == false && request.resource.data.stallId == null;
      allow update: if owns(uid) && validProfile(request.resource.data, uid)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['fullName', 'phoneNumber', 'stallId', 'stallSetupComplete'])
        && ((request.resource.data.stallId == resource.data.stallId
              && request.resource.data.stallSetupComplete == resource.data.stallSetupComplete)
          || (resource.data.role == 'vendor' && !resource.data.stallSetupComplete
              && request.resource.data.stallSetupComplete && request.resource.data.stallId == uid
              && !exists(/databases/$(database)/documents/stalls/$(uid))
              && validStall(getAfter(/databases/$(database)/documents/stalls/$(uid)).data, uid)));
    }
    match /stalls/{stallId} {
      // Owners must be able to read the absent document in a transaction.
      allow get: if owns(stallId);
      allow list, delete: if false;
      allow update: if configuredVendor(stallId) && validStallUpdate(request.resource.data, stallId);
      allow create: if owns(stallId) && validStall(request.resource.data, stallId)
        && get(/databases/$(database)/documents/users/$(stallId)).data.role == 'vendor'
        && get(/databases/$(database)/documents/users/$(stallId)).data.stallSetupComplete == false
        && getAfter(/databases/$(database)/documents/users/$(stallId)).data.stallSetupComplete == true
        && getAfter(/databases/$(database)/documents/users/$(stallId)).data.stallId == stallId;

      match /menuCategories/{categoryId} {
        allow read: if configuredVendor(stallId);
        allow create: if configuredVendor(stallId) && validMenuCategory(request.resource.data, stallId)
          && request.resource.data.revision == 1 && request.resource.data.createdAt == request.time
          && getAfter(categoryNamePath(stallId, request.resource.data.nameKey)).data.categoryId == categoryId;
        allow update: if configuredVendor(stallId) && validMenuCategory(request.resource.data, stallId)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.revision == resource.data.revision + 1
          && getAfter(categoryNamePath(stallId, request.resource.data.nameKey)).data.categoryId == categoryId
          && (request.resource.data.nameKey == resource.data.nameKey
            || !existsAfter(categoryNamePath(stallId, resource.data.nameKey)));
        allow delete: if false;
      }
      match /menuCategoryNames/{key} {
        allow read: if configuredVendor(stallId);
        allow create: if configuredVendor(stallId)
          && request.resource.data.keys().hasAll(['vendorUid','categoryId'])
          && request.resource.data.keys().hasOnly(['vendorUid','categoryId'])
          && request.resource.data.vendorUid == stallId
          && request.resource.data.categoryId is string
          && request.resource.data.categoryId.size() >= 1 && request.resource.data.categoryId.size() <= 128
          && request.resource.data.categoryId.matches('^[^/]+$')
          && getAfter(categoryPath(stallId, request.resource.data.categoryId)).data.nameKey == key;
        allow update: if false;
        allow delete: if configuredVendor(stallId)
          && getAfter(categoryPath(stallId, resource.data.categoryId)).data.nameKey != key;
      }
      match /menuFoods/{foodId} {
        allow read: if configuredVendor(stallId);
        allow create: if configuredVendor(stallId) && validMenuFood(request.resource.data, stallId)
          && request.resource.data.createdAt == request.time && request.resource.data.revision == 1
          && linkedFood(stallId, foodId, request.resource.data.categoryId);
        allow update: if configuredVendor(stallId) && validMenuFood(request.resource.data, stallId)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.revision == resource.data.revision + 1
          && linkedFood(stallId, foodId, request.resource.data.categoryId);
        allow delete: if menuDeletesEnabled() && configuredVendor(stallId)
          && !existsAfter(membershipPath(stallId, foodId));
      }
      match /menuMemberships/{foodId} {
        allow read: if configuredVendor(stallId);
        allow create, update: if configuredVendor(stallId)
          && request.resource.data.keys().hasAll(['vendorUid','categoryId'])
          && request.resource.data.keys().hasOnly(['vendorUid','categoryId'])
          && request.resource.data.vendorUid == stallId
          && request.resource.data.categoryId is string
          && request.resource.data.categoryId.size() >= 1 && request.resource.data.categoryId.size() <= 128
          && request.resource.data.categoryId.matches('^[^/]+$')
          && getAfter(foodPath(stallId, foodId)).data.vendorUid == stallId
          && getAfter(foodPath(stallId, foodId)).data.categoryId == request.resource.data.categoryId
          && getAfter(categoryPath(stallId, request.resource.data.categoryId)).data.vendorUid == stallId;
        allow delete: if menuDeletesEnabled() && configuredVendor(stallId)
          && !existsAfter(foodPath(stallId, foodId));
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
