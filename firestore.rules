rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }
    function configuredVendor(uid) {
      let profile = get(/databases/$(database)/documents/users/$(uid)).data;
      return owns(uid) && profile.role == 'vendor'
        && profile.stallSetupComplete == true && profile.stallId == uid;
    }
    function student() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'student';
    }
    function publicStallPath(uid) {
      return /databases/$(database)/documents/publicStalls/$(uid);
    }
    function studentMenuReader(uid) {
      return student() && exists(publicStallPath(uid));
    }
    function validPublicStall(d, uid) {
      let source = getAfter(/databases/$(database)/documents/stalls/$(uid)).data;
      return d.keys().hasAll(['vendorUid','name','category','preparationMinutes','status','updatedAt'])
        && d.keys().hasOnly(['vendorUid','name','category','preparationMinutes','status','pictureId','updatedAt'])
        && source.ownerUid == uid && d.vendorUid == uid
        && d.name == source.name && d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && d.name.matches('.*\\S.*')
        && d.category == source.category
        && d.category in ['Malay','Western','Chinese','Japanese','Korean','Beverage','Dessert']
        && d.preparationMinutes == source.preparationMinutes && d.preparationMinutes is int
        && d.preparationMinutes >= 1 && d.preparationMinutes <= 180
        && d.status == source.status && d.status in ['open','closed']
        && (('pictureId' in source && 'pictureId' in d
              && d.pictureId == source.pictureId && validStallPicture(d.pictureId))
          || (!('pictureId' in source) && !('pictureId' in d)))
        && d.updatedAt == request.time;
    }
    function validStallPicture(id) {
      return id is string && id in [
        'bento', 'bibimbap', 'burger', 'cake',
        'chinese_food_1', 'chinese_food_2', 'chinese_food_3', 'chinese_food_4',
        'coffee', 'dessert', 'drink', 'fruit_juice', 'icecream', 'japanese_1',
        'japanese_curry', 'korean_ramen', 'malay_drinks', 'malay_food',
        'nasi_lemak', 'sushi', 'teh_ais', 'tteokbokki', 'western_food'
      ];
    }
    function validStallUpdate(data, uid) {
      return data.keys().hasAll(['ownerUid', 'name', 'category', 'preparationMinutes', 'status', 'createdAt', 'updatedAt'])
        && data.ownerUid == uid && data.ownerUid == resource.data.ownerUid
        && data.createdAt == resource.data.createdAt
        && data.updatedAt is timestamp && data.updatedAt == request.time
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.name.matches('.*\\S.*')
        && data.category is string && data.category in ['Malay', 'Western', 'Chinese', 'Japanese', 'Korean', 'Beverage', 'Dessert']
        && data.preparationMinutes is int && data.preparationMinutes >= 1 && data.preparationMinutes <= 180
        && data.status in ['open', 'closed']
        && (!('pictureId' in data) || validStallPicture(data.pictureId))
        // Other existing fields are preserved; new unapproved fields, removals
        // or changes to ownership, creation time and queue/order data are denied.
        && data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'category', 'preparationMinutes', 'status', 'pictureId', 'updatedAt']);
    }
    // Keep false until the candidate paired-deletion tests pass and are reviewed.
    // The security suite opens ONLY this gate in its in-memory emulator rules,
    // and separately tests that this checked-in version still blocks deletion.
    function menuDeletesEnabled() { return false; }
    // Closed until the bounded checkout proof is executed and reviewed.
    function checkoutWritesEnabled() { return false; }
    function orderPath(id) { return /databases/$(database)/documents/orders/$(id); }
    function orderItemPath(id, index) { return /databases/$(database)/documents/orders/$(id)/items/$(index); }
    function requestPath(uid, id) { return /databases/$(database)/documents/users/$(uid)/checkoutRequests/$(id); }
    function counterPath(uid) { return /databases/$(database)/documents/checkoutCounters/$(uid); }
    function safeId(id) { return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[^/]+$'); }
    function validDraftItem(i) {
      return i is map && i.keys().hasAll(['foodId','name','description','categoryId','pictureId','priceSen','quantity','foodRevision'])
        && i.keys().hasOnly(['foodId','name','description','categoryId','pictureId','priceSen','quantity','foodRevision'])
        && safeId(i.foodId) && safeId(i.categoryId)
        && i.name is string && i.name.size() >= 1 && i.name.size() <= 100
        && i.name.matches('^\\S([\\s\\S]*\\S)?$')
        && i.description is string && i.description.size() >= 1 && i.description.size() <= 500
        && i.description.matches('^\\S([\\s\\S]*\\S)?$')
        && validStallPicture(i.pictureId) && i.priceSen is int && i.priceSen >= 1 && i.priceSen <= 100000
        && i.quantity is int && i.quantity >= 1 && i.quantity <= 20
        && i.foodRevision is int && i.foodRevision >= 1;
    }
    function draftSubtotal(i) { return i.priceSen * i.quantity; }
    function validRequest(d, uid, id) {
      return d.keys().hasAll(['schemaVersion','submissionId','studentUid','vendorUid','stallName','items','totalSen','paymentMethod','state','createdAt','updatedAt'])
        && d.keys().hasOnly(['schemaVersion','submissionId','studentUid','vendorUid','stallName','items','totalSen','paymentMethod','state','createdAt','updatedAt'])
        && d.schemaVersion == 1 && d.submissionId == id && id.matches('^[A-Za-z0-9]{20}$')
        && d.studentUid == uid && safeId(d.vendorUid)
        && d.stallName is string && d.stallName.size() >= 1 && d.stallName.size() <= 100
        && d.paymentMethod in ['ewallet','onlineBanking','card']
        && d.createdAt == request.time && d.updatedAt == request.time
        && d.items is list && d.items.size() >= 1 && d.items.size() <= 4
        && validDraftItem(d.items[0])
        && (d.items.size() < 2 || (validDraftItem(d.items[1]) && d.items[1].foodId != d.items[0].foodId))
        && (d.items.size() < 3 || (validDraftItem(d.items[2]) && d.items[2].foodId != d.items[0].foodId && d.items[2].foodId != d.items[1].foodId))
        && (d.items.size() < 4 || (validDraftItem(d.items[3]) && d.items[3].foodId != d.items[0].foodId && d.items[3].foodId != d.items[1].foodId && d.items[3].foodId != d.items[2].foodId))
        && d.totalSen is int && d.totalSen == draftSubtotal(d.items[0])
          + (d.items.size() > 1 ? draftSubtotal(d.items[1]) : 0)
          + (d.items.size() > 2 ? draftSubtotal(d.items[2]) : 0)
          + (d.items.size() > 3 ? draftSubtotal(d.items[3]) : 0);
    }
    function matchesDraft(i, expected) {
      // The durable draft has exactly eight validated, immutable fields. Only
      // these two additions may differ: removals/extra fields also appear in diff.
      return i.diff(expected).affectedKeys().hasOnly(['categoryName','subtotalSen'])
        && i.subtotalSen == draftSubtotal(expected);
    }
    function validOrderItem(i, expected, vendorUid) {
      let food = get(foodPath(vendorUid, i.foodId)).data;
      let category = get(categoryPath(vendorUid, i.categoryId)).data;
      let membership = get(membershipPath(vendorUid, i.foodId)).data;
      return matchesDraft(i, expected)
        && i.priceSen is int && i.quantity is int && i.subtotalSen is int && i.foodRevision is int
        // Exact map equality verifies the whole snapshot, including its shape,
        // against canonical data. No client-selected snapshot becomes authority.
        && i == {'foodId':expected.foodId, 'name':food.name, 'description':food.description,
          'categoryId':food.categoryId, 'categoryName':category.name, 'pictureId':food.pictureId,
          'priceSen':food.priceSen, 'quantity':expected.quantity,
          'subtotalSen':food.priceSen * expected.quantity, 'foodRevision':food.revision}
        && food.vendorUid == vendorUid && food.available == true
        // Quantity/price/type/picture bounds are already enforced on the
        // immutable prepared draft; equality above preserves every one of them.
        && category.vendorUid == vendorUid && i.categoryName == category.name
        && category.name is string && category.name.size() >= 1 && category.name.size() <= 50
        && category.revision is int && category.revision >= 1
        && category.createdAt is timestamp && category.updatedAt is timestamp
        && category.nameKey == category.name.lower()
        && membership == {'vendorUid':vendorUid, 'categoryId':i.categoryId};
    }
    function validOrder(d, id) {
      let intent = getAfter(requestPath(request.auth.uid, id)).data;
      let stall = get(/databases/$(database)/documents/stalls/$(d.vendorUid)).data;
      let counter = getAfter(counterPath(d.vendorUid)).data;
      let second = d.itemCount > 1 ? getAfter(orderItemPath(id, '1')).data : null;
      let third = d.itemCount > 2 ? getAfter(orderItemPath(id, '2')).data : null;
      let fourth = d.itemCount > 3 ? getAfter(orderItemPath(id, '3')).data : null;
      return d == {'schemaVersion':1, 'orderId':id, 'submissionId':id, 'studentUid':request.auth.uid,
          'vendorUid':intent.vendorUid, 'stallName':stall.name, 'preparationMinutes':stall.preparationMinutes,
          'ticket':counter.lastTicket, 'itemCount':intent.items.size(), 'totalSen':intent.totalSen,
          'status':'Pending', 'paymentMethod':intent.paymentMethod, 'paymentStatus':'simulated',
          'createdAt':request.time, 'firstItem':d.firstItem}
        && intent.state == 'confirmed' && intent.submissionId == id && intent.studentUid == request.auth.uid
        && d.stallName == intent.stallName
        && stall.ownerUid == d.vendorUid && stall.status == 'open'
        && d.preparationMinutes == stall.preparationMinutes
        && d.preparationMinutes is int && d.preparationMinutes >= 1 && d.preparationMinutes <= 180
        // Count/total/payment bounds originate in the immutable prepared draft.
        && d.itemCount is int && d.totalSen is int && d.ticket is int && d.ticket >= 1
        && counter.vendorUid == d.vendorUid && counter.lastOrderId == id
        && validOrderItem(d.firstItem, intent.items[0], d.vendorUid)
        && (d.itemCount < 2 || matchesDraft(second, intent.items[1]))
        && (d.itemCount < 3 || matchesDraft(third, intent.items[2]))
        && (d.itemCount < 4 || matchesDraft(fourth, intent.items[3]))
        && d.totalSen == d.firstItem.subtotalSen
          + (d.itemCount > 1 ? second.subtotalSen : 0) + (d.itemCount > 2 ? third.subtotalSen : 0)
          + (d.itemCount > 3 ? fourth.subtotalSen : 0);
    }
    function validCounter(d, uid) {
      let order = getAfter(orderPath(d.lastOrderId)).data;
      return d == {'schemaVersion':1, 'vendorUid':uid, 'lastTicket':order.ticket,
          'lastOrderId':order.orderId, 'updatedAt':request.time}
        && d.lastTicket is int && d.lastTicket >= 1 && d.lastTicket <= 2147483647
        && d.lastOrderId is string && d.lastOrderId.matches('^[A-Za-z0-9]{20}$')
        && order.studentUid == request.auth.uid && order.vendorUid == uid && order.status == 'Pending';
    }
    function confirmsRequest(uid, id, vendorUid) {
      let order = getAfter(orderPath(id)).data;
      return order.studentUid == uid && order.vendorUid == vendorUid && order.submissionId == id;
    }
    function validOrderChild(d, id, index) {
      let order = getAfter(orderPath(id)).data;
      let intent = getAfter(requestPath(request.auth.uid, id)).data;
      let slot = index == '1' ? 1 : (index == '2' ? 2 : 3);
      return order.studentUid == request.auth.uid && order.createdAt == request.time
        && slot < order.itemCount && validOrderItem(d, intent.items[slot], order.vendorUid);
    }
    function orderReader(d) {
      return signedIn() && ((d.studentUid == request.auth.uid && student())
        || (d.vendorUid == request.auth.uid && configuredVendor(request.auth.uid)));
    }
    function categoryPath(uid, id) {
      return /databases/$(database)/documents/stalls/$(uid)/menuCategories/$(id);
    }
    function foodPath(uid, id) {
      return /databases/$(database)/documents/stalls/$(uid)/menuFoods/$(id);
    }
    function membershipPath(uid, id) {
      return /databases/$(database)/documents/stalls/$(uid)/menuMemberships/$(id);
    }
    function categoryNamePath(uid, key) {
      return /databases/$(database)/documents/stalls/$(uid)/menuCategoryNames/$(key);
    }
    function validMenuCategory(d, uid) {
      return d.keys().hasAll(['vendorUid','name','nameKey','revision','createdAt','updatedAt'])
        && d.keys().hasOnly(['vendorUid','name','nameKey','revision','createdAt','updatedAt'])
        && d.vendorUid == uid && d.name is string && d.name.size() >= 1 && d.name.size() <= 50
        && d.name.matches('^[^\\s/]+( [^\\s/]+)*$')
        && d.nameKey == d.name.lower() && !(d.nameKey in ['.','..'])
        && !d.nameKey.matches('__.*__')
        && d.revision is int && d.revision >= 1 && d.createdAt is timestamp
        && d.updatedAt == request.time;
    }
    function validMenuFood(d, uid) {
      return d.keys().hasAll(['vendorUid','name','description','priceSen','categoryId','pictureId','available','revision','createdAt','updatedAt'])
        && d.keys().hasOnly(['vendorUid','name','description','priceSen','categoryId','pictureId','available','revision','createdAt','updatedAt'])
        && d.vendorUid == uid && d.name is string && d.name.size() >= 1 && d.name.size() <= 100
        && d.name.matches('^\\S([\\s\\S]*\\S)?$')
        && d.description is string && d.description.size() >= 1 && d.description.size() <= 500
        && d.description.matches('^\\S([\\s\\S]*\\S)?$')
        && d.priceSen is int && d.priceSen >= 1 && d.priceSen <= 100000
        && d.categoryId is string && d.categoryId.size() >= 1 && d.categoryId.size() <= 128
        && d.categoryId.matches('^[^/]+$')
        && validStallPicture(d.pictureId) && d.available is bool
        && d.revision is int && d.revision >= 1 && d.createdAt is timestamp
        && d.updatedAt == request.time;
    }
    function linkedFood(uid, id, categoryId) {
      return getAfter(categoryPath(uid, categoryId)).data.vendorUid == uid
        && getAfter(membershipPath(uid, id)).data.vendorUid == uid
        && getAfter(membershipPath(uid, id)).data.categoryId == categoryId;
    }
    // Both documents must exist and agree BEFORE deletion, and both must be
    // absent AFTER the atomic request. An orphan is not client-repairable.
    // Category deletion remains unconditionally denied; this does not prove
    // that a category is empty. App Food Delete stays gated pending execution
    // of the security suite. These rules have not been deployed.
    function pairedFoodDeletion(uid, id) {
      let food = get(foodPath(uid, id)).data;
      let membership = get(membershipPath(uid, id)).data;
      return food.vendorUid == uid && membership.vendorUid == uid
        && membership.keys().hasAll(['vendorUid', 'categoryId'])
        && membership.keys().hasOnly(['vendorUid', 'categoryId'])
        && food.categoryId == membership.categoryId
        && get(categoryPath(uid, food.categoryId)).data.vendorUid == uid
        && !existsAfter(foodPath(uid, id))
        && !existsAfter(membershipPath(uid, id));
    }
    function validProfile(data, uid) {
      return data.keys().hasAll(['uid', 'fullName', 'email', 'phoneNumber', 'role', 'createdAt', 'stallSetupComplete', 'stallId'])
        && data.keys().hasOnly(['uid', 'fullName', 'email', 'phoneNumber', 'role', 'createdAt', 'stallSetupComplete', 'stallId'])
        && data.uid == uid
        && data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 100
        && data.email is string && data.email == request.auth.token.email
        && data.phoneNumber is string && data.phoneNumber.size() >= 8 && data.phoneNumber.size() <= 30
        && data.role in ['student', 'vendor'] && data.createdAt is timestamp
        && data.stallSetupComplete is bool
        && ((!data.stallSetupComplete && data.stallId == null)
          || (data.role == 'vendor' && data.stallSetupComplete && data.stallId == uid));
    }
    function validStall(data, uid) {
      return data.keys().hasAll(['ownerUid', 'name', 'category', 'preparationMinutes', 'status', 'createdAt'])
        && data.keys().hasOnly(['ownerUid', 'name', 'category', 'preparationMinutes', 'status', 'createdAt'])
        && data.ownerUid == uid
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.category is string && data.category in ['Malay', 'Western', 'Chinese', 'Japanese', 'Korean', 'Beverage', 'Dessert']
        && data.preparationMinutes is int && data.preparationMinutes >= 1 && data.preparationMinutes <= 180
        && data.status == 'closed' && data.createdAt == request.time;
    }
    match /users/{uid} {
      allow get: if owns(uid);
      allow list, delete: if false;
      allow create: if owns(uid) && validProfile(request.resource.data, uid)
        && request.resource.data.createdAt == request.time
        && request.resource.data.stallSetupComplete == false && request.resource.data.stallId == null;
      allow update: if owns(uid) && validProfile(request.resource.data, uid)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['fullName', 'phoneNumber', 'stallId', 'stallSetupComplete'])
        && ((request.resource.data.stallId == resource.data.stallId
              && request.resource.data.stallSetupComplete == resource.data.stallSetupComplete)
          || (resource.data.role == 'vendor' && !resource.data.stallSetupComplete
              && request.resource.data.stallSetupComplete && request.resource.data.stallId == uid
              && !exists(/databases/$(database)/documents/stalls/$(uid))
              && validStall(getAfter(/databases/$(database)/documents/stalls/$(uid)).data, uid)));
    }
    match /users/{studentUid}/checkoutRequests/{submissionId} {
      allow read: if owns(studentUid);
      allow create: if checkoutWritesEnabled() && owns(studentUid) && student()
        && validRequest(request.resource.data, studentUid, submissionId)
        && (request.resource.data.state == 'pending'
          || (request.resource.data.state == 'cancelled'
            && (!existsAfter(orderPath(submissionId)) || getAfter(orderPath(submissionId)).data.studentUid != studentUid)));
      allow update: if checkoutWritesEnabled() && owns(studentUid) && student()
        && resource.data.state == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state','updatedAt'])
        && request.resource.data.updatedAt == request.time
        && ((request.resource.data.state == 'confirmed'
            && confirmsRequest(studentUid, submissionId, resource.data.vendorUid))
          || (request.resource.data.state == 'cancelled'
            && (!existsAfter(orderPath(submissionId)) || getAfter(orderPath(submissionId)).data.studentUid != studentUid)));
      allow delete: if false;
    }
    match /checkoutCounters/{vendorUid} {
      allow read: if studentMenuReader(vendorUid) || configuredVendor(vendorUid);
      allow create: if checkoutWritesEnabled() && student() && validCounter(request.resource.data, vendorUid)
        && request.resource.data.lastTicket == 1;
      allow update: if checkoutWritesEnabled() && student() && resource.data.schemaVersion == 1
        && resource.data.keys().hasOnly(['schemaVersion','vendorUid','lastTicket','lastOrderId','updatedAt'])
        && resource.data.lastTicket is int && resource.data.lastTicket >= 1 && resource.data.lastTicket < 2147483647
        && resource.data.lastOrderId is string && resource.data.updatedAt is timestamp
        && resource.data.vendorUid == vendorUid && validCounter(request.resource.data, vendorUid)
        && request.resource.data.lastTicket == resource.data.lastTicket + 1;
      allow delete: if false;
    }
    match /orders/{orderId} {
      allow read: if orderReader(resource.data);
      allow create: if checkoutWritesEnabled() && student() && validOrder(request.resource.data, orderId);
      allow update, delete: if false;
      match /items/{index} {
        allow read: if orderReader(get(orderPath(orderId)).data);
        allow create: if checkoutWritesEnabled() && signedIn() && index in ['1','2','3']
          && validOrderChild(request.resource.data, orderId, index);
        allow update, delete: if false;
      }
    }
    match /publicStalls/{vendorUid} {
      allow read: if student() || configuredVendor(vendorUid);
      allow create, update: if configuredVendor(vendorUid)
        && validPublicStall(request.resource.data, vendorUid);
      allow delete: if false;
    }
    match /stalls/{stallId} {
      // Owners must be able to read the absent document in a transaction.
      allow get: if owns(stallId);
      allow list, delete: if false;
      allow update: if configuredVendor(stallId) && validStallUpdate(request.resource.data, stallId)
        // Once published, old clients cannot silently leave a stale public
        // status/price context behind. The application writes both atomically.
        && (!exists(publicStallPath(stallId))
          || validPublicStall(getAfter(publicStallPath(stallId)).data, stallId));
      allow create: if owns(stallId) && validStall(request.resource.data, stallId)
        && get(/databases/$(database)/documents/users/$(stallId)).data.role == 'vendor'
        && get(/databases/$(database)/documents/users/$(stallId)).data.stallSetupComplete == false
        && getAfter(/databases/$(database)/documents/users/$(stallId)).data.stallSetupComplete == true
        && getAfter(/databases/$(database)/documents/users/$(stallId)).data.stallId == stallId;

      match /menuCategories/{categoryId} {
        allow read: if studentMenuReader(stallId) || configuredVendor(stallId);
        allow create: if configuredVendor(stallId) && validMenuCategory(request.resource.data, stallId)
          && request.resource.data.revision == 1 && request.resource.data.createdAt == request.time
          && getAfter(categoryNamePath(stallId, request.resource.data.nameKey)).data.categoryId == categoryId;
        allow update: if configuredVendor(stallId) && validMenuCategory(request.resource.data, stallId)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.revision == resource.data.revision + 1
          && getAfter(categoryNamePath(stallId, request.resource.data.nameKey)).data.categoryId == categoryId
          && (request.resource.data.nameKey == resource.data.nameKey
            || !existsAfter(categoryNamePath(stallId, resource.data.nameKey)));
        allow delete: if false;
      }
      match /menuCategoryNames/{key} {
        allow read: if configuredVendor(stallId);
        allow create: if configuredVendor(stallId)
          && request.resource.data.keys().hasAll(['vendorUid','categoryId'])
          && request.resource.data.keys().hasOnly(['vendorUid','categoryId'])
          && request.resource.data.vendorUid == stallId
          && request.resource.data.categoryId is string
          && request.resource.data.categoryId.size() >= 1 && request.resource.data.categoryId.size() <= 128
          && request.resource.data.categoryId.matches('^[^/]+$')
          && getAfter(categoryPath(stallId, request.resource.data.categoryId)).data.nameKey == key;
        allow update: if false;
        allow delete: if configuredVendor(stallId)
          && getAfter(categoryPath(stallId, resource.data.categoryId)).data.nameKey != key;
      }
      match /menuFoods/{foodId} {
        allow read: if (studentMenuReader(stallId) && resource.data.available == true)
          || configuredVendor(stallId);
        allow create: if configuredVendor(stallId) && validMenuFood(request.resource.data, stallId)
          && request.resource.data.createdAt == request.time && request.resource.data.revision == 1
          && linkedFood(stallId, foodId, request.resource.data.categoryId);
        allow update: if configuredVendor(stallId) && validMenuFood(request.resource.data, stallId)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.revision == resource.data.revision + 1
          && linkedFood(stallId, foodId, request.resource.data.categoryId);
        allow delete: if menuDeletesEnabled() && configuredVendor(stallId)
          && pairedFoodDeletion(stallId, foodId);
      }
      match /menuMemberships/{foodId} {
        allow read: if configuredVendor(stallId);
        allow create, update: if configuredVendor(stallId)
          && request.resource.data.keys().hasAll(['vendorUid','categoryId'])
          && request.resource.data.keys().hasOnly(['vendorUid','categoryId'])
          && request.resource.data.vendorUid == stallId
          && request.resource.data.categoryId is string
          && request.resource.data.categoryId.size() >= 1 && request.resource.data.categoryId.size() <= 128
          && request.resource.data.categoryId.matches('^[^/]+$')
          && getAfter(foodPath(stallId, foodId)).data.vendorUid == stallId
          && getAfter(foodPath(stallId, foodId)).data.categoryId == request.resource.data.categoryId
          && getAfter(categoryPath(stallId, request.resource.data.categoryId)).data.vendorUid == stallId;
        allow delete: if menuDeletesEnabled() && configuredVendor(stallId)
          && pairedFoodDeletion(stallId, foodId);
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
